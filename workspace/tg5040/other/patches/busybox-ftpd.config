# File Transfer.pak's FTP server: busybox with ONLY what `tcpsvd ... ftpd -w` needs. Each CONFIG_X=y is
# switched on in an allnoconfig .config, then oldconfig fills dependencies (see the tg5040 makefile;
# KCONFIG_ALLCONFIG does not survive busybox's allnoconfig, which also picks ash as sh, undone there).
# BUSYBOX: the `busybox APPLET` dispatcher; a FAT card cannot hold applet symlinks. ftpd lists
# directories through ls_main in-process, so ls comes along; timestamps so FTP apps show dates.
CONFIG_BUSYBOX=y
CONFIG_TCPSVD=y
CONFIG_FTPD=y
CONFIG_FEATURE_FTPD_WRITE=y
CONFIG_FEATURE_FTPD_ACCEPT_BROKEN_LIST=y
CONFIG_FEATURE_FTPD_AUTHENTICATION=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
# owner/group columns: without them LIST is "mode links size date", which FTP apps' parsers misread.
# In ftpd's chroot there is no /etc/passwd, so they print as numbers (0 0), the usual shape.
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_LFS=y
CONFIG_FEATURE_IPV6=y
