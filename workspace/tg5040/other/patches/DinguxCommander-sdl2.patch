diff --git a/src/def.h b/src/def.h
index fc6e531..708fff5 100644
--- a/src/def.h
+++ b/src/def.h
@@ -110,11 +110,33 @@
 #define MYKEY_OPEN          1	// A
 #define MYKEY_PARENT        0	// B
 #define MYKEY_OPERATION     3	// X
-#define MYKEY_SELECT        8	// SELECT
-#define MYKEY_TRANSFER      9	// START
-#define MYKEY_MENU			19	// MENU
+#define MYKEY_SELECT        6	// SELECT
+#define MYKEY_TRANSFER      7	// START
+#define MYKEY_MENU			8	// MENU (BTN_MODE; the pad only has joy buttons 0..10, 19 never fired)
 #define PATH_DEFAULT        "/"
 #define FILE_SYSTEM         "/dev/mmcblk1p1"
+#elif defined(PLATFORM_H700)
+// Joys for Anbernic RG35XX Plus/H on the MinUI Zero image. The pad enumerates as an SDL JOYSTICK
+// ("muOS-Keys", 17 buttons, dpad on hat 0), NOT keyboard events. Button indices are muOS's
+// gamecontrollerdb mapping (a:b3 b:b4 x:b6 y:b5 L1:b7 R1:b8 back/SELECT:b9 start:b10 guide/MENU:b11),
+// verified live on an H 2026-09-15. The dpad is a HAT, handled by window.cpp's JOYHATMOTION path, so
+// UP/DOWN/LEFT/RIGHT stay as keysym tokens (large values, no collision with buttons 0-16). Shipping
+// the TG5040 indices here mapped the wrong buttons ("controls all over the place", reported).
+#define MYKEY_UP            SDLK_UP           // Up   (hat)
+#define MYKEY_RIGHT         SDLK_RIGHT        // Right(hat)
+#define MYKEY_DOWN          SDLK_DOWN         // Down (hat)
+#define MYKEY_LEFT          SDLK_LEFT         // Left (hat)
+#define MYKEY_SYSTEM        5                 // Y
+#define MYKEY_PAGEUP        7                 // L1
+#define MYKEY_PAGEDOWN      8                 // R1
+#define MYKEY_OPEN          3                 // A
+#define MYKEY_PARENT        4                 // B
+#define MYKEY_OPERATION     6                 // X
+#define MYKEY_SELECT        9                 // SELECT
+#define MYKEY_TRANSFER      10                // START
+#define MYKEY_MENU			11                // MENU (guide)
+#define PATH_DEFAULT        "/"
+#define FILE_SYSTEM         "/dev/mmcblk0p6"  // the ROMS card partition; Disk info only
 #elif defined(PLATFORM_MY282)
 // Keys for Mini Zero 28
 #define MYKEY_UP            SDLK_UP         // Up
diff --git a/src/sdlutils.cpp b/src/sdlutils.cpp
index 9e47238..9946776 100644
--- a/src/sdlutils.cpp
+++ b/src/sdlutils.cpp
@@ -104,7 +104,10 @@ void SDL_utils::renderAll(void)
 #if defined(PLATFORM_MY355)
     SDL_Rect rect{0,0,640,480};
 	SDL_BlitScaled(Globals::g_screen, NULL, Globals::g_screen_real,&rect);
-#elif defined(PLATFORM_TG5040)
+#elif defined(PLATFORM_TG5040) || defined(PLATFORM_H700)
+	// H700 (Anbernic 640x480 landscape) shares this generic integer-scale-and-center path with the
+	// Brick. Without it, H700 fell into the #else portrait-rotate branch (480x640, for MY282/Zero28)
+	// and wrote past the end of the 640x480 framebuffer -> segfault on launch (fixed 2026-09-15).
 	int sw = Globals::g_screen_real->w;
 	int sh = Globals::g_screen_real->h;
 	int sx = (sw / SCREEN_WIDTH);
diff --git a/src/window.cpp b/src/window.cpp
index 23ec08b..68a1bb4 100644
--- a/src/window.cpp
+++ b/src/window.cpp
@@ -52,6 +52,10 @@ const int CWindow::execute(void)
             }
             else if(l_event.type == SDL_JOYBUTTONDOWN)
             {
+                // MinUI Zero: the physical MENU button opens the System menu (Select all, New
+                // directory, Disk info, Quit), matching how MENU opens a menu elsewhere in the
+                // firmware; Quit inside it keeps the exit discoverable. (Dan, 2026-09-08: was a
+                // direct quit, changed to open the menu.) MENU->SYSTEM is the keyPress remap below.
                 printf("joy:%d\n",l_event.jbutton.button); fflush(stdout);
                 SDL_Event key_event;
 				key_event.key.keysym.sym = l_event.jbutton.button==MYKEY_MENU?MYKEY_SYSTEM:l_event.jbutton.button;
