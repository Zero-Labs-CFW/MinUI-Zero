diff --git a/src/def.h b/src/def.h
index fc6e531..b6170c3 100644
--- a/src/def.h
+++ b/src/def.h
@@ -110,11 +110,32 @@
 #define MYKEY_OPEN          1	// A
 #define MYKEY_PARENT        0	// B
 #define MYKEY_OPERATION     3	// X
-#define MYKEY_SELECT        8	// SELECT
-#define MYKEY_TRANSFER      9	// START
-#define MYKEY_MENU			19	// MENU
+#define MYKEY_SELECT        6	// SELECT
+#define MYKEY_TRANSFER      7	// START
+#define MYKEY_MENU			8	// MENU (BTN_MODE; the pad only has joy buttons 0..10, 19 never fired)
 #define PATH_DEFAULT        "/"
 #define FILE_SYSTEM         "/dev/mmcblk1p1"
+#elif defined(PLATFORM_H700)
+// Keys for Anbernic RG35XX Plus/H on the MinUI Zero image. The pad arrives as KEYBOARD scancodes
+// there (the same CODE_* table workspace/h700/platform/platform.h reads), not joystick buttons, so
+// these are keysyms. Shipping the TG5040 joystick table on the H left only R2 (BACKSPACE = keysym 8
+// = MYKEY_MENU) doing anything, reported 2026-09-15. Same semantics as the Brick: Y opens the
+// System menu, MENU remaps to it (window.cpp), L1/R1 page.
+#define MYKEY_UP            SDLK_w            // Up
+#define MYKEY_RIGHT         SDLK_d            // Right
+#define MYKEY_DOWN          SDLK_s            // Down
+#define MYKEY_LEFT          SDLK_a            // Left
+#define MYKEY_SYSTEM        SDLK_LALT         // Y
+#define MYKEY_PAGEUP        SDLK_e            // L1
+#define MYKEY_PAGEDOWN      SDLK_t            // R1
+#define MYKEY_OPEN          SDLK_LSHIFT       // A
+#define MYKEY_PARENT        SDLK_LCTRL        // B
+#define MYKEY_OPERATION     SDLK_SPACE        // X
+#define MYKEY_SELECT        SDLK_RSHIFT       // SELECT
+#define MYKEY_TRANSFER      SDLK_RETURN       // START
+#define MYKEY_MENU			SDLK_ESCAPE       // MENU
+#define PATH_DEFAULT        "/"
+#define FILE_SYSTEM         "/dev/mmcblk0p5"  // muOS-layout ROMS partition; Disk info only
 #elif defined(PLATFORM_MY282)
 // Keys for Mini Zero 28
 #define MYKEY_UP            SDLK_UP         // Up
diff --git a/src/window.cpp b/src/window.cpp
index 23ec08b..68a1bb4 100644
--- a/src/window.cpp
+++ b/src/window.cpp
@@ -52,6 +52,10 @@ const int CWindow::execute(void)
             }
             else if(l_event.type == SDL_JOYBUTTONDOWN)
             {
+                // MinUI Zero: the physical MENU button opens the System menu (Select all, New
+                // directory, Disk info, Quit), matching how MENU opens a menu elsewhere in the
+                // firmware; Quit inside it keeps the exit discoverable. (Dan, 2026-09-08: was a
+                // direct quit, changed to open the menu.) MENU->SYSTEM is the keyPress remap below.
                 printf("joy:%d\n",l_event.jbutton.button); fflush(stdout);
                 SDL_Event key_event;
 				key_event.key.keysym.sym = l_event.jbutton.button==MYKEY_MENU?MYKEY_SYSTEM:l_event.jbutton.button;
