diff --git a/src/usb_gadget.c b/src/usb_gadget.c
index c4b31b9..8d6e38d 100644
--- a/src/usb_gadget.c
+++ b/src/usb_gadget.c
@@ -1010,6 +1010,20 @@ usb_gadget * init_usb_mtp_gadget(mtp_ctx * ctx)
 			usbctx->usb_ffs_config->flags |= htole32(FUNCTIONFS_HAS_SS_DESC);
 #endif
 
+			// MinUI Zero: an MS OS extended compat ID "MTP" on interface 0, the layout Android's MTP server
+			// sends (AOSP MtpDescriptors.cpp). With a vendor-class interface (so macOS's camera agent leaves
+			// it alone), this is what lets Windows bind its MTP driver.
+			usbctx->usb_ffs_config->flags |= htole32(FUNCTIONFS_HAS_MS_OS_DESC);
+			usbctx->usb_ffs_config->os_count = htole32(1);
+			usbctx->usb_ffs_config->os_header.interface = 1;
+			usbctx->usb_ffs_config->os_header.dwLength = htole32(sizeof(struct usb_os_desc_header) + sizeof(struct usb_ext_compat_desc));
+			usbctx->usb_ffs_config->os_header.bcdVersion = htole16(1);
+			usbctx->usb_ffs_config->os_header.wIndex = htole16(4);
+			usbctx->usb_ffs_config->os_header.bCount = 1;
+			usbctx->usb_ffs_config->os_header.Reserved = 0;
+			usbctx->usb_ffs_config->os_compat.bFirstInterfaceNumber = 0;
+			usbctx->usb_ffs_config->os_compat.Reserved1 = 1;
+			memcpy(usbctx->usb_ffs_config->os_compat.CompatibleID, "MTP", 3);
 #endif
 			usbctx->usb_ffs_config->length = htole32(sizeof(usb_ffs_cfg));
 
