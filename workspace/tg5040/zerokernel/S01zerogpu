#!/bin/sh
# Zero kernel (bin/zerokernel.sh), installed as /etc/rc.d/S01zerogpu. Backstop for zinit's gpu_binds(): when zinit
# takes the stock path (manifest mismatch on another firmware build, failsafe, a failed mount) procd runs rc.d
# without the DDK 1.11 binds, and GLES would be a black screen. Does nothing on the stock kernel or when zinit
# already bound them. Bind mounts live only in this boot: the stock kernel always sees the stock files.
case "$(uname -r)" in *-zero) ;; *) exit 0 ;; esac
G=/usr/lib/zero/gpu F=rgx.fw.22.102.54.38
[ -f $G/firmware/$F ] || exit 0
grep -q " /lib/firmware/$F " /proc/mounts && exit 0
for f in libEGL.so libGLESv2.so libGLES_CM.so libIMGegl.so libsrv_um.so \
         libglslcompiler.so libusc.so libpvrNULL_WSEGL.so; do
	[ -f $G/lib/$f ] && [ -e /usr/lib/$f ] && mount --bind $G/lib/$f /usr/lib/$f
done
mount --bind $G/firmware/$F /lib/firmware/$F
exit 0
