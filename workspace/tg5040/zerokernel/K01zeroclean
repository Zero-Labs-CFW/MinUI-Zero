#!/bin/sh
# Zero kernel (bin/zerokernel.sh), installed as /etc/rc.d/K01zeroclean. procd runs every /etc/rc.d/K* script on an
# orderly reboot or shutdown (stock /etc/inittab: ::shutdown:/etc/init.d/rcS K shutdown; K01 runs before K99umount),
# never on a 10 s power hold, a crash or a flat battery. An orderly reboot (File Transfer, an update unpack, a dev
# reboot) is not the kernel failing, so it must not count toward the unclean-session escape (critique H3) or as a
# fallback (L8). Same block as bin/shutdown, which covers the menu power-off (the PMIC cut skips rc.d).
_zo=; read -r _zo < /proc/sys/kernel/osrelease
if [ "$_zo" = 4.9.191-zero ] && read -r _zw _zi _zn 2>/dev/null < /etc/zero-kernel.state; then
	case "$_zw" in
	zarmed) if [ -f /tmp/zero-armed ]; then _zw=zclean; _zn=0; else _zw=menu; fi ;;  # re-armed by THIS boot, or left over
	armed|zclean|health) _zw=menu ;;  # this boot ran userspace far enough to stop in order: not a kernel failure
	esac
	echo "$_zw $_zi $_zn" > /etc/zero-kernel.state
fi
exit 0
