+/*
+ * MinUI Zero (H700, 2026-11-05): large card reads in SPL through the controller's internal DMA (IDMAC) instead of the
+ * CPU FIFO loop, which moved the 1.3 MB vendor boot package at ~9 MB/s. Set up as mainline Linux does for this IP
+ * (sunxi-mmc.c, sun50i-a100/h616 config): chained descriptors, addresses shifted right by 2 (idma_des_shift), 16-bit
+ * size field, FIFO threshold 0x20070008. Reads only, into DRAM, 64-byte aligned (whole cache lines, so invalidating
+ * cannot touch a neighbour); anything else stays on the CPU path.
+ */
+#define ZDMA_CHUNK	0x8000				/* per descriptor */
+#define ZDMA_MAX_DESC	128				/* 4 MiB per command; bigger reads use the CPU path */
+#define ZDMA_DES_CH	BIT(4)
+#define ZDMA_DES_FD	BIT(3)
+#define ZDMA_DES_LD	BIT(2)
+#define ZDMA_DES_DIC	BIT(1)
+#define ZDMA_DES_ER	BIT(5)
+#define ZDMA_DES_OWN	BIT(31)
+
+struct zdma_des {
+	u32 config;
+	u32 buf_size;
+	u32 buf_addr;
+	u32 next;
+};
+
+/* in DRAM, not BSS: BSS is in SRAM on the H616 SPL, and this DMA only ever runs once DRAM is up (reads into DRAM) */
+#define zdma_des	((struct zdma_des *)0x43830000UL)
+
+static int zdma_usable(struct mmc_data *data)
+{
+	ulong dst = (ulong)data->dest, len = data->blocks * data->blocksize;
+
+	return (data->flags & MMC_DATA_READ) && len >= 4096 && len <= ZDMA_CHUNK * ZDMA_MAX_DESC && !(len & 63) &&
+	       !(dst & 63) && dst >= CFG_SYS_SDRAM_BASE && dst + len <= 0x100000000UL;
+}
+
+static void zdma_start(struct sunxi_mmc_priv *priv, struct mmc_data *data)
+{
+	ulong dst = (ulong)data->dest, len = data->blocks * data->blocksize;
+	int n = 0;
+
+	while (len) {
+		ulong sz = len > ZDMA_CHUNK ? ZDMA_CHUNK : len;
+
+		zdma_des[n].config = ZDMA_DES_CH | ZDMA_DES_OWN | ZDMA_DES_DIC;
+		zdma_des[n].buf_size = sz;
+		zdma_des[n].buf_addr = (u32)(dst >> 2);
+		zdma_des[n].next = (u32)((ulong)&zdma_des[n + 1] >> 2);
+		dst += sz;
+		len -= sz;
+		n++;
+	}
+	zdma_des[0].config |= ZDMA_DES_FD;
+	zdma_des[n - 1].config |= ZDMA_DES_LD | ZDMA_DES_ER;
+	zdma_des[n - 1].config &= ~ZDMA_DES_DIC;
+	zdma_des[n - 1].next = 0;
+	flush_dcache_range((ulong)zdma_des, (ulong)&zdma_des[ZDMA_MAX_DESC]);
+	invalidate_dcache_range((ulong)data->dest, (ulong)data->dest + data->blocks * data->blocksize);
