diff --git a/arch/arm/mach-sunxi/zero_params.h b/arch/arm/mach-sunxi/zero_params.h
new file mode 100644
index 00000000..021f8605
--- /dev/null
+++ b/arch/arm/mach-sunxi/zero_params.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * MinUI Zero H700 stage 2 (2026-11-06): what the SPL hands our DRAM loader. The SPL jumps to the loader's entry at
+ * EL3 (AArch64, MMU and caches off) with x0 pointing at this block, in DRAM. Every address is physical. The same
+ * header is compiled into the SPL (arch/arm/mach-sunxi/zero_params.h) and into the loader: keep them identical.
+ */
+#ifndef ZERO_PARAMS_H
+#define ZERO_PARAMS_H
+
+#define ZP_MAGIC	0x5a504152u	/* "ZPAR" */
+#define ZP_VERSION	1u
+
+/* DRAM map shared by the SPL and the loader (1 GiB from 0x40000000; the SPL's own heap, BSS and page tables sit at
+ * 0x4f000000 and up and die with it) */
+#define ZL_LOAD_ADDR	0x4c000000ull	/* loader image (64-byte header first), 1 MiB region incl. its stack */
+#define ZL_LOAD_MAX	0x00100000ull
+#define ZL_KGZ_ADDR	0x45000000ull	/* compressed kernel as stored in boot.img (vendor U-Boot's own boot.img address) */
+#define ZL_KGZ_MAX	0x02000000ull	/* 32 MiB */
+#define ZL_FDT_MAX	0x00080000ull	/* room the loader has to grow the package dtb (built in place at its load address) */
+#define ZL_HDR_ADDR	0x44f00000ull	/* the 2048-byte boot.img header */
+
+/* loader image header (64 bytes, at ZL_LOAD_ADDR); the SPL refuses the loader unless magic, length and sum match */
+#define ZL_HDR_MAGIC	"ZEROLDR1"	/* 8 bytes */
+#define ZL_HDR_LEN	64
+#define ZL_SUM_STAMP	0x5f0a6c39u	/* the sum field counts as this, like eGON */
+struct zero_loader_hdr {
+	char magic[8];
+	unsigned int length;		/* whole image incl. this header, multiple of 512, <= ZL_LOAD_MAX - 64 KiB */
+	unsigned int entry;		/* offset of the entry point from the image start (64) */
+	unsigned int sum;		/* sum of every 32-bit word of the image, this field read as ZL_SUM_STAMP */
+	unsigned int version;		/* 1 */
+	unsigned int reserved[10];
+};
+
+#define ZP_FLAG_CARD	(1u << 0)	/* booted from the card (not FEL) */
+
+struct zero_params {
+	unsigned int magic;
+	unsigned int version;
+	unsigned int size;		/* sizeof(struct zero_params) */
+	unsigned int flags;		/* ZP_FLAG_* */
+	unsigned long long monitor;	/* vendor monitor run address; its head: +0x14 entry, +0x24 block, +0x30 words, +0xb0 fdt */
+	unsigned long long uboot;	/* vendor U-Boot run address from the package (0x4a000000); nothing is loaded there */
+	unsigned long long dtb, dtb_len;	/* package dtb as read (raw bytes, at the address where the FDT is also built) */
+	unsigned long long dtbo, dtbo_len;	/* package dtbo as read, dtbo_len 0 if none */
+	unsigned long long bootimg_hdr;		/* the 2048-byte boot.img header */
+	unsigned long long kernel_gz, kernel_gz_len;	/* compressed kernel exactly as stored */
+	unsigned long long ramdisk, ramdisk_len;	/* ramdisk as stored (the Zero image ships a 512-byte dummy) */
+	unsigned long long kernel_addr;	/* inflate to here (boot.img kernel_addr) */
+	unsigned long long kernel_max;	/* room there */
+	unsigned long long fdt_max;	/* room to grow the dtb in place */
+	unsigned int dram_mib;
+	unsigned int toc1_len;
+	unsigned int dram_words[32];	/* stock boot0 +0x38, the trained values the monitor needs for resume */
+	unsigned char board_block[8];	/* stock boot0 +0xf0 */
+	unsigned int spl_us[4];		/* SPL timing, microseconds since reset: start, DRAM up, card ready, all reads done */
+	unsigned int card_khz;
+	unsigned int bus_width;
+	unsigned int pmic_boot_regs;	/* AXP2202 reg 0x20 | reg 0x00 << 8 | reg 0xf0 << 16; all reads succeeded */
+};
+
+#endif
diff --git a/arch/arm/mach-sunxi/zero_vendor.c b/arch/arm/mach-sunxi/zero_vendor.c
new file mode 100644
index 00000000..becdfebe
--- /dev/null
+++ b/arch/arm/mach-sunxi/zero_vendor.c
@@ -0,0 +1,758 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * MinUI Zero: hand off from the upstream SPL to the H700 vendor monitor and vendor U-Boot (boot speed, 2026-11-04).
+ *
+ * The stock boot0 is replaced only for DRAM (and everything before it); the rest of the stock chain runs unchanged.
+ * This does exactly what boot0's own hand-off does (read from the RG35XX H boot0, routine at 0x2adda / 0x2ac34):
+ *  - read the boot package (TOC1, sector 32800) and load each item to the run address in its own image header (+0x2c):
+ *    u-boot 0x4a000000, monitor 0x48000000; dtbo to u-boot + 1 MiB, dtb to u-boot + 2 MiB;
+ *  - u-boot head: 32 DRAM words at +0x30, storage type +0xe4 (1 = SD card), optee/monitor/func flags +0x4e8..+0x4ea,
+ *    package length +0x4f4, DRAM size in MiB +0x4f8;
+ *  - monitor: the same 32 DRAM words at +0x30, boot0's 8-byte block at +0x24, the dtb address at +0xb0;
+ *  - point the RVBAR at the monitor and warm-reset into AArch64 (RMR), as boot0 does.
+ * One difference on purpose: bit 31 of the U-Boot head word +0x8c (DRAM word 23) is set. The vendor U-Boot reads it as
+ * "boot0 DRAM parameters need no update" (get_boot_dram_update_flag, 0x4a00296c in the Plus U-Boot); clear, it takes
+ * the boot0 in the first BROM slot (ours), pastes 0x80 bytes of DRAM words over +0x38 (our code) and writes that to
+ * BOTH slots with a fixed checksum, which bricked two cards (2026-11-04, Codex review).
+ * The DRAM words and the 8-byte block come from a pinned copy of the stock boot0 (see the card layout below): the
+ * vendor monitor uses them to bring DRAM back after standby, so they must be the stock trained values.
+ * Idea and contract cross-checked against BaseOS's notes (pvaibhav); this code is ours.
+ *
+ * CARD LAYOUT (reserved: 8 MiB in, inside the empty 8513-20071 gap that the image and the Plus card share; clear of
+ * the boot packages at 24576/32800 and of secure storage near 12288): two pinned copies of the stock boot0
+ * (128 sectors each) at ZV_PIN_A and ZV_PIN_B, written by the installer before ours goes into BROM's first slot, and
+ * one attempt-marker sector at ZV_MARK.
+ *
+ * SAFETY NET. zero_vendor_early() (first thing in sunxi_board_init, before PMIC/DRAM, no card access: BSS and MMC
+ * state live in DRAM): RTC GP15 nonzero = the last attempt was never acknowledged: keep it in GP14, mark a restore
+ * pending; arm an 8 s watchdog. zero_vendor_boot() (after DRAM): a pending restore (RTC flag or the on-card marker,
+ * which survives a power cut that clears the RTC) restores the pinned stock boot0 to slot 512 then slot 16, each body
+ * first and header last, each verified, then clears both markers and resets into the stock chain. Otherwise it writes
+ * the on-card marker, verifies it, and hands off. Acknowledgement (clearing both markers) is Linux's job once it runs.
+ * Known gap: a DRAM-init failure on the recovery boot itself loops (restore needs DRAM).
+ */
+#include <cpu_func.h>
+#include <mmc.h>
+#include <part.h>
+#include <spl.h>
+#include <asm/io.h>
+#include <asm/global_data.h>
+#include <asm/arch/cpu.h>
+#include <asm/armv8/mmu.h>
+#include <asm/arch/timer.h>
+#include <asm/arch/watchdog.h>
+#include <linux/delay.h>
+#include <linux/string.h>
+#include <time.h>
+#include "zero_params.h"
+#include <asm/arch/pmic_bus.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define ZV_SLOT_PRIMARY	16	/* BROM tries this first */
+#define ZV_SLOT_BACKUP	512	/* BROM falls back here on a bad header or checksum */
+#define ZV_PIN_A	16384	/* pinned stock boot0 copies (ours, reserved; see the card layout above) */
+#define ZV_PIN_B	16512
+#define ZV_MARK		16640	/* on-card attempt marker */
+#define ZV_B0_SECTORS	128	/* 64 KiB stock boot0 */
+#define ZV_B0_LEN	0x10000
+#ifndef ZV_TOC1_SECTOR
+#define ZV_TOC1_SECTOR	32800	/* test builds may read the backup copy at 24576 instead */
+#endif
+#define ZV_TOC1_ADDR	0x42e00000UL
+#define ZV_TOC1_MAX	(4 << 20)
+#define ZV_ITEM_SIZE	368
+#define ZV_PIN_BUF	0x43800000UL	/* 64 KiB: the validated pinned boot0 */
+#define ZV_CHK_BUF	0x43820000UL	/* 64 KiB, then the MMC DMA descriptors (2 KiB, sunxi_mmc.c zdma_des) */
+#define ZV_STAMP	0x5f0a6c39
+#define ZV_RESTORE	0x5a56ffffU
+#define ZV_MARK_MAGIC	"ZERO-ATTEMPT-V1"
+
+static u32 rd32(ulong a) { return readl((void *)a); }
+
+/* progress words for the FEL harness (read back with sunxi-fel in the same run): step, detail */
+#define ZV_STATUS	0x47ff0000UL
+#ifndef ZV_STOP
+#define ZV_STOP	99	/* test builds: return to FEL after this step */
+#endif
+/* the same checkpoint in RTC general-purpose register 15 (survives watchdog resets) */
+#define ZV_RTC_GP15	(SUNXI_RTC_BASE + 0x13c)
+#define ZV_RTC_GP14	(SUNXI_RTC_BASE + 0x138)
+
+static struct sunxi_wdog *zv_wdog(void)
+{
+	return &((struct sunxi_timer_reg *)SUNXI_TIMER_BASE)->wdog[0];
+}
+
+static void zv_status(u32 step, u32 detail)
+{
+	writel(0x5a560000 | step, (void *)ZV_RTC_GP15);
+	writel(0x5a560000 | step, (void *)ZV_STATUS);
+	writel(detail, (void *)(ZV_STATUS + 4));
+	flush_dcache_range(ZV_STATUS, ZV_STATUS + 64);
+}
+
+static void zv_wdog_arm(u32 intv)	/* 0x7 = 8 s, 0 = 0.5 s */
+{
+	writel(WDT_CFG_RESET, &zv_wdog()->cfg);
+	writel((intv << 4) | WDT_MODE_EN, &zv_wdog()->mode);
+	writel(WDT_CTRL_KEY | WDT_CTRL_RESTART, &zv_wdog()->ctl);
+}
+
+static void __noreturn zv_reset(void)
+{
+	zv_wdog_arm(0);
+	for (;;)
+		;
+}
+
+static int zv_read(struct blk_desc *bd, ulong sector, ulong bytes, void *dst)
+{
+	ulong n = (bytes + 511) / 512;
+
+	return blk_dread(bd, sector, n, dst) == n ? 0 : -EIO;
+}
+
+static int zv_write(struct blk_desc *bd, ulong sector, ulong count, const void *src)
+{
+	return blk_dwrite(bd, sector, count, src) == count ? 0 : -EIO;
+}
+
+/* the eGON checksum: every word summed, the checksum field counted as the stamp */
+static u32 zv_egon_sum(const u8 *img, u32 len)
+{
+	u32 sum = 0, i;
+
+	for (i = 0; i < len; i += 4)
+		sum += (i == 12) ? ZV_STAMP : *(const u32 *)(img + i);
+	return sum;
+}
+
+/* a stock boot0 we may restore from: eGON magic, exactly 64 KiB, a valid checksum, and not an upstream SPL (whose
+ * header carries "SPL" at +0x14) */
+static int zv_stock_ok(const u8 *img)
+{
+	return !memcmp(img + 4, "eGON.BT0", 8) && *(const u32 *)(img + 16) == ZV_B0_LEN &&
+	       zv_egon_sum(img, ZV_B0_LEN) == *(const u32 *)(img + 12) && memcmp(img + 0x14, "SPL", 3);
+}
+
+static int zv_load_pin(struct blk_desc *bd, u8 *buf)
+{
+	if (!zv_read(bd, ZV_PIN_A, ZV_B0_LEN, buf) && zv_stock_ok(buf))
+		return 0;
+	if (!zv_read(bd, ZV_PIN_B, ZV_B0_LEN, buf) && zv_stock_ok(buf))
+		return 0;
+	return -ENOENT;
+}
+
+/*
+ * The safety net runs before DRAM (2026-11-05, universal SPL): a board whose DRAM init fails must still get its stock
+ * boot0 back by itself, and the old restore needed DRAM. So the card is read and written here through two 2 KiB SRAM
+ * buffers (BSS lives in SRAM on this SoC, see zero_vendor_early), under the MMC driver's DMA threshold: the CPU path.
+ */
+#define ZV_CHUNK	4	/* sectors per transfer */
+static u8 zv_buf[ZV_CHUNK * 512] __aligned(64), zv_chk[ZV_CHUNK * 512] __aligned(64);
+
+static u32 zv_sum_chunk(ulong s, u32 sum)
+{
+	u32 i;
+
+	for (i = 0; i < sizeof(zv_buf); i += 4)
+		sum += (!s && i == 12) ? ZV_STAMP : *(const u32 *)(zv_buf + i);
+	return sum;
+}
+
+/* a pinned stock boot0, streamed: eGON magic, exactly 64 KiB, not an SPL, a valid checksum */
+static int zv_pin_ok(struct blk_desc *bd, ulong pin)
+{
+	u32 sum = 0, want = 0;
+	ulong s;
+
+	for (s = 0; s < ZV_B0_SECTORS; s += ZV_CHUNK) {
+		if (zv_read(bd, pin + s, sizeof(zv_buf), zv_buf))
+			return 0;
+		if (!s) {
+			if (memcmp(zv_buf + 4, "eGON.BT0", 8) || *(const u32 *)(zv_buf + 16) != ZV_B0_LEN ||
+			    !memcmp(zv_buf + 0x14, "SPL", 3))
+				return 0;
+			want = *(const u32 *)(zv_buf + 12);
+		}
+		sum = zv_sum_chunk(s, sum);
+	}
+	return sum == want;
+}
+
+/*
+ * One BROM slot from a validated pin, header last: the old header is invalidated first, so a power cut mid-way leaves
+ * a slot BROM skips. Each body chunk is read back, and the body copied must still sum to the pin's checksum before the
+ * header goes down.
+ */
+static int zv_put_slot(struct blk_desc *bd, ulong slot, ulong pin)
+{
+	u32 sum, want = 0, skip;
+	ulong s;
+	int tries;
+
+	for (tries = 0; tries < 3; tries++) {
+		memset(zv_chk, 0, 512);
+		if (zv_write(bd, slot, 1, zv_chk))
+			continue;
+		sum = 0;
+		for (s = 0; s < ZV_B0_SECTORS; s += ZV_CHUNK) {
+			if (zv_read(bd, pin + s, sizeof(zv_buf), zv_buf))
+				break;
+			if (!s)
+				want = *(const u32 *)(zv_buf + 12);
+			sum = zv_sum_chunk(s, sum);
+			skip = s ? 0 : 1;	/* the header sector goes last */
+			if (zv_write(bd, slot + s + skip, ZV_CHUNK - skip, zv_buf + skip * 512) ||
+			    zv_read(bd, slot + s + skip, (ZV_CHUNK - skip) * 512, zv_chk) ||
+			    memcmp(zv_chk, zv_buf + skip * 512, (ZV_CHUNK - skip) * 512))
+				break;
+		}
+		if (s < ZV_B0_SECTORS || sum != want)
+			continue;
+		if (zv_read(bd, pin, 512, zv_buf) || *(const u32 *)(zv_buf + 12) != want ||
+		    zv_write(bd, slot, 1, zv_buf) || zv_read(bd, slot, 512, zv_chk) || memcmp(zv_chk, zv_buf, 512))
+			continue;
+		return 0;
+	}
+	return -EIO;
+}
+
+static int zv_marker_set(struct blk_desc *bd, int on)
+{
+	static u8 m[512] __aligned(64), chk[512] __aligned(64);
+
+	memset(m, 0, sizeof(m));
+	if (on)
+		strcpy((char *)m, ZV_MARK_MAGIC);
+	if (zv_write(bd, ZV_MARK, 1, m) || zv_read(bd, ZV_MARK, 512, chk) || memcmp(chk, m, 512))
+		return -EIO;
+	return 0;
+}
+
+static int zv_marker_get(struct blk_desc *bd)
+{
+	static u8 m[512] __aligned(64);
+
+	return !zv_read(bd, ZV_MARK, 512, m) && !memcmp(m, ZV_MARK_MAGIC, sizeof(ZV_MARK_MAGIC));
+}
+
+/*
+ * Stock boot0 leaves these PLLs enabled (GPU0 0x030, VE 0x058, AUDIO 0x078, 0x0e0) and the vendor kernel relies on it:
+ * without them, once its drivers load, the CPUs crawl and timers seem frozen (sleeps never return, the logo stays).
+ * Found 2026-11-05 by diffing CCU state on the RG35XX H; the factor fields already match stock, only the enable bit
+ * differs.
+ */
+static void zv_plls_on(void)
+{
+	static const u16 off[] = { 0x030, 0x058, 0x078, 0x0e0 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(off); i++)
+		setbits_le32((void *)(ulong)(SUNXI_CCM_BASE + off[i]), BIT(31));
+	udelay(100);	/* let them lock before anything downstream uses them */
+}
+
+/*
+ * Data cache on for the hand-off's card reads. With the MMU off every AArch64 data access is Device-nGnRnE, so each
+ * word the MMC FIFO hands us is a strictly ordered uncached DRAM store: the 1.3 MB boot package read at ~5 MB/s
+ * (264 ms, RG35XX H, 2026-11-05). Upstream turns the D-cache on in SPL for ARMv7 only. Our own map: SRAM A1/C (where
+ * the SPL runs and keeps its stack) and DRAM normal cacheable, everything else device. The hand-off flushes and turns
+ * it off again before the jump (flush_dcache_all, dcache_disable).
+ */
+#define ZV_TLB		0x4f000000UL	/* page tables, below the SPL's malloc (0x4fd00000) and BSS */
+#define ZV_TLB_LEN	0x10000UL
+
+static struct mm_region zv_mem_map[] = {
+	{ .virt = 0x0UL, .phys = 0x0UL, .size = 0x100000UL,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE },
+	{ .virt = 0x100000UL, .phys = 0x100000UL, .size = 0x40000000UL - 0x100000UL,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) | PTE_BLOCK_NON_SHARE },
+	{ .virt = 0x40000000UL, .phys = 0x40000000UL, .size = CONFIG_SUNXI_DRAM_MAX_SIZE,
+	  .attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE },
+	{ 0, }
+};
+
+static void zv_cache_on(void)
+{
+	mem_map = zv_mem_map;
+	gd->arch.tlb_addr = ZV_TLB;
+	gd->arch.tlb_size = ZV_TLB_LEN;
+	gd->arch.tlb_fillptr = 0;
+	dcache_enable();
+}
+
+/*
+ * Boot timing: microseconds since reset (the 24 MHz generic counter runs from reset; the Linux boot clock reads the
+ * same counter) into RTC general-purpose registers, read back from Linux: GP11 SPL start, GP10 DRAM up (hand-off code
+ * entry), GP8 card ready, GP9 boot package loaded (just before the jump).
+ */
+static void zv_stamp(u32 reg)
+{
+	u64 c;
+
+	asm volatile("isb; mrs %0, cntpct_el0" : "=r"(c));
+	writel((u32)(c / 24), (void *)(ulong)(SUNXI_RTC_BASE + reg));
+}
+
+/*
+ * Breadcrumbs for the wake path (2026-11-05): GP13 = starts since the RTC lost power (top byte) | the last step
+ * reached (low byte); GP12 = DRAM MiB (bits 31:16).
+ */
+#define ZV_RTC_GP13	(SUNXI_RTC_BASE + 0x134)
+#define ZV_RTC_GP12	(SUNXI_RTC_BASE + 0x130)
+static void zv_crumb(u32 step)
+{
+	clrsetbits_le32((void *)ZV_RTC_GP13, 0xff, step);
+}
+
+/* restore the pinned stock boot0 to the backup slot, then the primary, then clear the markers and reset; no DRAM */
+static void __noreturn zv_restore(struct blk_desc *bd)
+{
+	ulong pin;
+
+	zv_crumb(0x30);
+	pin = zv_pin_ok(bd, ZV_PIN_A) ? ZV_PIN_A : zv_pin_ok(bd, ZV_PIN_B) ? ZV_PIN_B : 0;
+	if (!pin) {
+		/* nothing trustworthy to restore from: never touch a BROM slot; stay pending, try again next start */
+		zv_crumb(0x3e);
+		writel(0x5a56fffe, (void *)ZV_RTC_GP14);
+		zv_reset();
+	}
+	zv_crumb(0x31);
+	if (zv_put_slot(bd, ZV_SLOT_BACKUP, pin)) {
+		zv_crumb(0x3f);
+		zv_reset();	/* still pending: retried on the next start */
+	}
+	zv_crumb(0x32);
+	if (zv_put_slot(bd, ZV_SLOT_PRIMARY, pin)) {
+		zv_crumb(0x3f);
+		zv_reset();
+	}
+	zv_crumb(0x33);
+	zv_marker_set(bd, 0);
+	writel(0, (void *)ZV_RTC_GP15);
+	zv_crumb(0x34);
+	zv_reset();
+}
+
+/*
+ * The card, brought up once: before DRAM by zero_vendor_early (card boots), else by the hand-off (FEL). Kept in BSS,
+ * which survives to the hand-off because crt0 skips its late BSS clear on this SoC.
+ */
+static struct blk_desc *zv_bd;
+static u32 zv_mmc_err;		/* zv_status step and detail of a failed bring-up */
+static int zv_marked;		/* the attempt marker is on the card for this start */
+
+static struct blk_desc *zv_mmc_up(void)
+{
+	struct mmc *mmc;
+	int ret;
+
+	if (zv_bd)
+		return zv_bd;
+	/*
+	 * Before DRAM the only heap is the early arena above gd, and with SPL_STACK_R + SYS_MALLOC_SIMPLE spl_init() leaves
+	 * its limit at 0 (the DRAM heap set up by spl_relocate_stack_gd is meant to be the first): every calloc failed, the
+	 * card never registered, and the hand-off could not register it either (Plus, 2026-11-06: a start loop). The
+	 * arena stays valid after the move to DRAM, and so does the card's struct in it.
+	 */
+	if (!gd->malloc_limit)
+		gd->malloc_limit = CONFIG_VAL(SYS_MALLOC_F_LEN);
+	ret = mmc_initialize(NULL);
+	if (ret) {
+		zv_mmc_err = 2 | (u32)ret << 8;
+		return NULL;
+	}
+	mmc = find_mmc_device(0);
+	if (!mmc && !board_mmc_init(NULL))	/* mmc_initialize() probes once: a failed early try must not end the retry */
+		mmc = find_mmc_device(0);
+	if (!mmc) {
+		zv_mmc_err = 3;
+		return NULL;
+	}
+	ret = mmc_init(mmc);
+	if (ret) {
+		/*
+		 * A card that fails high-speed init here would fail it on every start, before the safety net can restore
+		 * stock: slot 16 would keep a valid SPL forever (Codex review 2026-11-05). BROM just read us from this card
+		 * at its own default speed, so retry without high speed before giving up.
+		 */
+		struct mmc_config *cfg = (struct mmc_config *)mmc->cfg;
+
+		cfg->host_caps &= ~(MMC_MODE_HS | MMC_MODE_HS_52MHz);
+		cfg->f_max = 25000000;
+		mmc->has_init = 0;
+		ret = mmc_init(mmc);
+	}
+	if (ret) {
+		zv_mmc_err = 4 | (u32)ret << 8;
+		return NULL;
+	}
+	zv_stamp(0x120);
+	zv_crumb(0x20);
+	/* timing diagnostics (GP4): negotiated card clock in kHz, bus width in the top byte */
+	writel((mmc->bus_width << 24) | (mmc->clock / 1000), (void *)(SUNXI_RTC_BASE + 0x110));
+	zv_bd = mmc_get_blk_desc(mmc);
+	return zv_bd;
+}
+
+u32 sunxi_get_boot_device(void);
+
+extern char __bss_start[], __bss_end[];
+
+void zero_vendor_early(void)
+{
+	u32 last = readl((void *)ZV_RTC_GP15), prev = readl((void *)ZV_RTC_GP13) & 0xff;
+	struct blk_desc *bd;
+
+	/*
+	 * BSS is in SRAM here (SPL_BSS_START_ADDR, build.sh) and crt0 does not clear it on this SoC, so clear it now, before
+	 * anything uses it. Nothing earlier in board_init_f touches BSS: upstream keeps it in DRAM, which is not up yet.
+	 */
+	memset(__bss_start, 0, __bss_end - __bss_start);
+	zv_stamp(0x12c);
+	writel((readl((void *)ZV_RTC_GP13) & 0xff000000) + 0x01000001, (void *)ZV_RTC_GP13);
+	if (sunxi_get_boot_device() == BOOT_DEVICE_BOARD)
+		return;		/* FEL: nothing on the card to undo */
+	/*
+	 * A wake from suspend-to-RAM reboots through BROM. Stock boot0 resumes when RTC 0x1f8 bit 16 is set (DRAM kept,
+	 * jump to the monitor's warm entry in RTC 0x1fc) and clears the register; we cannot resume, and Linux puts stock
+	 * boot0 in slot 16 for every sleep. If that swap was missed, cold boot instead (the session is lost): drop the
+	 * flag, and release the DRAM pads. The monitor's suspend holds them once DRAM is in self-refresh (RTC 0x1f4 bit 0
+	 * cleared, monitor 0x48011820); stock boot0 sets the bit again in its DRAM init on both paths (0x27294 cold,
+	 * 0x24bfe resume), upstream DRAM init never does. Held, every start trained through frozen pads and hung before
+	 * DRAM came up: the bit is in the RTC domain, so neither the watchdog nor a power-off cleared it (RG35XX H,
+	 * 2026-11-05: 44 starts, all stopped before DRAM, until stock boot0 went back on the card). On every other start
+	 * the bit is already 1.
+	 */
+	setbits_le32((void *)(SUNXI_RTC_BASE + 0x1f4), BIT(0));
+	writel(0, (void *)(SUNXI_RTC_BASE + 0x1f8));
+	if (last) {
+		if (last != ZV_RESTORE)
+			writel(last, (void *)ZV_RTC_GP14);	/* where the last attempt stopped */
+		writel(ZV_RESTORE, (void *)ZV_RTC_GP15);
+	} else {
+		writel(0x5a560001, (void *)ZV_RTC_GP15);
+	}
+	zv_wdog_arm(0x7);	/* 8 s: a hang anywhere before the hand-off resets back here */
+	/*
+	 * Before PMIC and DRAM: a pending restore (RTC flag, or the on-card marker an unacknowledged start left, which
+	 * survives a power cut that clears the RTC) puts stock boot0 back now; otherwise the marker goes down for this
+	 * start, so a DRAM init that hangs or fails is undone on the next one (watchdog), with no DRAM needed.
+	 * If the last start died inside this card work (its crumb still 0x02, 0x20, or 0x30-0x3f but not 0x34, a finished
+	 * restore), skip it once: the hand-off does the same work after DRAM, the path every earlier release took, so a
+	 * hang here cannot loop forever.
+	 */
+	if (prev == 0x02 || prev == 0x20 || ((prev & 0xf0) == 0x30 && prev != 0x34)) {
+		zv_crumb(0x06);
+		return;
+	}
+	zv_crumb(0x02);
+	bd = zv_mmc_up();
+	if (!bd) {
+		zv_crumb(0x05);		/* no card before DRAM: the hand-off tries again and reports it */
+		return;
+	}
+	if (readl((void *)ZV_RTC_GP15) == ZV_RESTORE || zv_marker_get(bd))
+		zv_restore(bd);
+	zv_marked = !zv_marker_set(bd, 1);
+	zv_crumb(0x0e);			/* card work done: DRAM next */
+}
+
+#ifdef ZV_TRACE
+/* test builds: markers at the monitor's and U-Boot's entry points that write their own code to RTC GP15, then carry on
+ * to the original first instruction. Stubs live in free DRAM just below each image. */
+#define ZV_STUB64	0x47ff1000UL	/* below the monitor (0x48000000) */
+#define ZV_STUB32	0x49ff0000UL	/* below U-Boot (0x4a000000), within an A32 branch */
+static void zv_trace_stubs(ulong monitor, ulong uboot)
+{
+	u32 *m = (u32 *)ZV_STUB64, *u = (u32 *)ZV_STUB32;
+	u32 w = readl((void *)monitor), t;
+	long off;
+
+	t = monitor + ((s32)(w << 6) >> 4);		/* imm26 * 4, sign-extended */
+	m[0] = 0xd2800000 | (0x013c << 5) | 16;		/* movz x16, #0x013c */
+	m[1] = 0xf2a00000 | (0x0700 << 5) | 16;		/* movk x16, #0x0700, lsl 16 */
+	m[2] = 0x52800000 | (0x0020 << 5) | 17;		/* movz w17, #0x20 */
+	m[3] = 0x72a00000 | (0x5a56 << 5) | 17;		/* movk w17, #0x5a56, lsl 16 */
+	m[4] = 0xb9000000 | (16 << 5) | 17;		/* str w17, [x16] */
+	off = (long)t - (long)(ZV_STUB64 + 20);
+	m[5] = 0x14000000 | ((off >> 2) & 0x3ffffff);	/* b <original entry> */
+	off = (long)ZV_STUB64 - (long)monitor;
+	writel(0x14000000 | ((off >> 2) & 0x3ffffff), (void *)monitor);
+
+	w = readl((void *)uboot);
+	t = uboot + 8 + ((s32)(w << 8) >> 6);
+	u[0] = 0xe59f0008;				/* ldr r0, [pc, #8] */
+	u[1] = 0xe59f1008;				/* ldr r1, [pc, #8] */
+	u[2] = 0xe5801000;				/* str r1, [r0] */
+	off = (long)t - (long)(ZV_STUB32 + 12 + 8);
+	u[3] = 0xea000000 | ((off >> 2) & 0xffffff);	/* b <original reset> */
+	u[4] = SUNXI_RTC_BASE + 0x13c;
+	u[5] = 0x5a560021;
+	off = (long)ZV_STUB32 - (long)(uboot + 8);
+	writel(0xea000000 | ((off >> 2) & 0xffffff), (void *)uboot);
+}
+#endif
+
+/* Reads stay within the IDMAC command limit, including the gzip kernel. */
+static int zv_read_large(struct blk_desc *bd, ulong sector, ulong bytes, void *dst)
+{
+	while (bytes) {
+		ulong n = min(bytes, 4UL << 20);
+
+		if (zv_read(bd, sector, n, dst))
+			return -EIO;
+		sector += (n + 511) / 512;
+		dst = (u8 *)dst + n;
+		bytes -= n;
+	}
+	return 0;
+}
+
+/* Vendor 4a03cd6c repairs ratio0 or ratio>60 at <=3499mV. Its low-voltage limit is3450mV.
+ * Be stricter than its median-of-three: any suspect sample leaves policy/repair to vendor U-Boot. */
+static int zv_stage2_battery_ok(void)
+{
+	u8 ratio, hi, lo;
+	u32 i;
+
+	if (pmic_bus_read(0xa4, &ratio) || !ratio || ratio > 100)
+		return 0;
+	for (i = 0; i < 3; i++) {
+		if (pmic_bus_read(0xc4, &hi) || pmic_bus_read(0xc5, &lo) ||
+		    (((hi & 0x3f) << 8) | lo) < 3500)
+			return 0;
+	}
+	return 1;
+}
+
+/* Invalid/absent loaders leave the stage-1 chain intact. All destinations are fixed, not card-controlled. */
+static void zv_stage2(struct blk_desc *bd, ulong monitor, ulong uboot, u32 toc_len, const u8 *pin, int card,
+		      u32 dtb_len, u32 dtbo_len)
+{
+	struct zero_loader_hdr *h = (void *)ZL_LOAD_ADDR;
+	struct zero_params *p = (void *)(ZL_HDR_ADDR + 2048);
+	u32 *b = (void *)ZL_HDR_ADDR;
+	u32 n, i, sum = 0, k, r;
+	u8 reason, status, scratch, v;
+	/* Plus AXP2202 normal-boot state, independently decoded in verify-uboot-effects.md.
+	 * Columns: register, bits cleared, bits set. Do not apply this profile to other PMICs. */
+	static const u8 power[][3] = {
+		{0x27, 0, 8}, {0x41, 0, 0x80}, {0x81, 0x0d, 0x0c},
+		{0x0b, 0x11, 1}, {0xd3, 0, 0x80},
+		{0x97, 0x1f, 0x0d}, {0x98, 0x1f, 0x0d}, {0x90, 0x30, 0x20},
+		{0x9e, 0x1f, 0x1c}, {0x91, 0, 8}, {0x19, 0, 0x10},
+		{0xc0, 2, 0}, {0x50, 0x0c, 0x10}, {0x08, 0, 3},
+		{0x5c, 0xff, 3}, {0x5d, 0xff, 0xeb},
+	};
+
+	if (zv_read(bd, 16896, 512, h) || memcmp(h->magic, ZL_HDR_MAGIC, 8))
+		return;
+	n = h->length;
+	if (n < 512 || n > ZL_LOAD_MAX - 65536 || (n & 511) || h->entry != ZL_HDR_LEN ||
+	    h->version != ZP_VERSION || zv_read_large(bd, 16896, n, h))
+		return;
+	for (i = 0; i < n / 4; i++)
+		sum += i == 4 ? ZL_SUM_STAMP : ((u32 *)h)[i];
+	if (sum != h->sum || h->length != n || h->entry != ZL_HDR_LEN || h->version != ZP_VERSION ||
+	    memcmp(h->magic, ZL_HDR_MAGIC, 8) || monitor != 0x48000000 || uboot != 0x4a000000 ||
+	    dtb_len < 40 || dtb_len > ZL_FDT_MAX)
+		return;
+	/* Android v0 header. Refuse layouts outside the qualified Plus memory map. */
+	if (zv_read(bd, 188416, 2048, b) || memcmp(b, "ANDROID!", 8) || b[9] != 2048 ||
+	    b[3] != 0x40080000 || b[5] != 0x42000000 || b[6])
+		return;
+	k = b[2]; r = b[4];
+	if (!k || k > ZL_KGZ_MAX || r > 0x100000 ||
+	    zv_read_large(bd, 188420, k, (void *)ZL_KGZ_ADDR) ||
+	    (r && zv_read_large(bd, 188420 + ((k + 2047) & ~2047U) / 512, r, (void *)0x42000000)))
+		return;
+	if (pmic_bus_read(0x20, &reason) || pmic_bus_read(0, &status) || pmic_bus_read(0xf0, &scratch))
+		return;
+	/* Vendor's battery-absent repair and one-shot charger mode stay on the vendor path. */
+	if (!(status & 8) || ((scratch & 8) && (!reason || reason > 16 || (reason & (reason - 1)))))
+		return;
+	if (!zv_stage2_battery_ok())
+		return;
+	for (i = 0; i < ARRAY_SIZE(power); i++) {
+		if (pmic_bus_read(power[i][0], &v) ||
+		    pmic_bus_write(power[i][0], (v & ~power[i][1]) | power[i][2]))
+			return;
+	}
+	memset(p, 0, sizeof(*p));
+	p->magic = ZP_MAGIC; p->version = ZP_VERSION; p->size = sizeof(*p);
+	p->flags = card ? ZP_FLAG_CARD : 0;
+	p->monitor = monitor; p->uboot = uboot;
+	p->dtb = uboot + 0x200000; p->dtb_len = dtb_len;
+	p->dtbo = uboot + 0x100000; p->dtbo_len = dtbo_len;
+	p->bootimg_hdr = ZL_HDR_ADDR;
+	p->kernel_gz = ZL_KGZ_ADDR; p->kernel_gz_len = k;
+	p->ramdisk = 0x42000000; p->ramdisk_len = r;
+	p->kernel_addr = 0x40080000; p->kernel_max = 0x42000000 - 0x40080000;
+	p->fdt_max = ZL_FDT_MAX; p->dram_mib = gd->ram_size >> 20; p->toc1_len = toc_len;
+	memcpy(p->dram_words, pin + 0x38, 128);
+	memcpy(p->board_block, pin + 0xf0, 8);
+	p->spl_us[0] = rd32(SUNXI_RTC_BASE + 0x12c);
+	p->spl_us[1] = rd32(SUNXI_RTC_BASE + 0x128);
+	p->spl_us[2] = rd32(SUNXI_RTC_BASE + 0x120);
+	zv_stamp(0x10c);
+	p->spl_us[3] = rd32(SUNXI_RTC_BASE + 0x10c);
+	p->card_khz = rd32(SUNXI_RTC_BASE + 0x110) & 0xffffff;
+	p->bus_width = rd32(SUNXI_RTC_BASE + 0x110) >> 24;
+	p->pmic_boot_regs = reason | (u32)status << 8 | (u32)scratch << 16;
+	zv_plls_on();
+	flush_dcache_all();
+	dcache_disable();
+	invalidate_icache_all();
+	asm volatile("dsb sy; isb" ::: "memory");
+	((void (*)(struct zero_params *))(ulong)(ZL_LOAD_ADDR + ZL_HDR_LEN))(p);
+	zv_reset();
+}
+
+void zero_vendor_boot(void)
+{
+	u8 *pin = (u8 *)ZV_PIN_BUF;
+	int card = sunxi_get_boot_device() != BOOT_DEVICE_BOARD;
+	struct blk_desc *bd;
+	ulong pkg = ZV_TOC1_ADDR, uboot = 0, monitor = 0;
+	u32 count, len, i, dtb_len = 0, dtbo_len = 0;
+
+	zv_stamp(0x128);
+	zv_crumb(0x10);
+	writel((u32)(gd->ram_size >> 20) << 16, (void *)ZV_RTC_GP12);
+	zv_cache_on();
+	printf("zero: vendor hand-off\n");
+	if (!card)
+		zv_wdog_arm(0x7);	/* FEL test runs: a hang still resets */
+	bd = zv_mmc_up();
+	if (!bd) {
+		zv_status(zv_mmc_err & 0xff, (int)zv_mmc_err >> 8);
+		return;
+	}
+	if (card && !zv_marked) {	/* the card did not come up before DRAM: do the early card work here */
+		if (readl((void *)ZV_RTC_GP15) == ZV_RESTORE || zv_marker_get(bd))
+			zv_restore(bd);
+		zv_marked = !zv_marker_set(bd, 1);
+	}
+	zv_status(10, 0);
+	if (ZV_STOP == 10)
+		return;
+	if (zv_load_pin(bd, pin)) {
+		printf("zero: no valid pinned stock boot0\n");
+		zv_status(5, 0);
+		return;
+	}
+	if (card && !zv_marked) {	/* written before DRAM (zero_vendor_early) */
+		zv_status(6, 0);
+		return;
+	}
+	zv_crumb(0x40);
+	zv_stamp(0x100);	/* timing: pinned copy checked, marker written (GP0) */
+	if (zv_read(bd, ZV_TOC1_SECTOR, 512, (void *)pkg) || memcmp((void *)pkg, "sunxi-package", 13)) {
+		zv_status(7, rd32(pkg));
+		return;
+	}
+	len = rd32(pkg + 36);
+	count = rd32(pkg + 32);
+	if (len < 512 || len > ZV_TOC1_MAX || count == 0 || count > 16 ||
+	    zv_read(bd, ZV_TOC1_SECTOR, 64 + count * ZV_ITEM_SIZE, (void *)pkg)) {
+		zv_status(7, len);
+		return;
+	}
+	zv_status(12, count);
+	if (ZV_STOP == 12)
+		return;
+	/* each item straight from the card to where it runs, as boot0 does; bounded by the package and by DRAM below the
+	 * SPL's own stack, heap and BSS (0x4fd00000 and up) */
+	for (i = 0; i < count; i++) {
+		const char *name = (const char *)(pkg + 64 + i * ZV_ITEM_SIZE);
+		u32 off = rd32(pkg + 64 + i * ZV_ITEM_SIZE + 64), size = rd32(pkg + 64 + i * ZV_ITEM_SIZE + 68);
+		ulong dst, end;
+
+		if ((off & 511) || off >= len || size > len - off) {
+			zv_status(13, i);
+			return;
+		}
+		if (!strcmp(name, "u-boot") || !strcmp(name, "monitor")) {
+			static u8 hdr[512] __aligned(64);
+
+			if (zv_read(bd, ZV_TOC1_SECTOR + off / 512, 512, hdr)) {
+				zv_status(14, i);
+				return;
+			}
+			dst = rd32((ulong)hdr + 0x2c);
+			if (name[0] == 'u')
+				uboot = dst;
+			else
+				monitor = dst;
+		} else if (!strcmp(name, "dtbo") && uboot) {
+			dst = uboot + 0x100000;
+			dtbo_len = size;
+		} else if (!strcmp(name, "dtb") && uboot) {
+			dst = uboot + 0x200000;
+			dtb_len = size;
+		} else {
+			continue;
+		}
+		end = dst + ((size + 511) & ~511UL);
+		if (dst < 0x40000000UL || end > 0x4fd00000UL || (dst < ZV_CHK_BUF + ZV_B0_LEN + 0x800 && end > ZV_TOC1_ADDR) ||
+		    (dst < ZV_TLB + ZV_TLB_LEN && end > ZV_TLB)) {	/* nor over the live page tables (code review) */
+			zv_status(15, dst);
+			return;
+		}
+		zv_status(20 + i, dst);
+		if (zv_read(bd, ZV_TOC1_SECTOR + off / 512, size, (void *)dst)) {
+			zv_status(16, dst);
+			return;
+		}
+	}
+	zv_stamp(0x10c);	/* timing: every package item read (GP3) */
+	zv_status(11, 0);
+	if (ZV_STOP == 11)
+		return;
+	if (!uboot || !monitor) {
+		zv_status(8, count);
+		return;
+	}
+	zv_stage2(bd, monitor, uboot, len, pin, card, dtb_len, dtbo_len);
+	memcpy((void *)(uboot + 0x30), pin + 0x38, 0x80);
+	writel(readl((void *)(uboot + 0x8c)) | BIT(31), (void *)(uboot + 0x8c));	/* no boot0 write-back, see top */
+	writel(1, (void *)(uboot + 0xe4));			/* booted from the SD card (boot media 0) */
+	writeb(0, (void *)(uboot + 0x4e8));			/* no optee */
+	writeb(1, (void *)(uboot + 0x4e9));			/* monitor present */
+	writeb(0, (void *)(uboot + 0x4ea));			/* func mask: no logo item */
+	writel(len, (void *)(uboot + 0x4f4));
+	writel(gd->ram_size >> 20, (void *)(uboot + 0x4f8));
+	memcpy((void *)(monitor + 0x30), pin + 0x38, 0x80);
+	memcpy((void *)(monitor + 0x24), pin + 0xf0, 8);
+	writel(uboot + 0x200000, (void *)(monitor + 0xb0));
+	zv_plls_on();
+	zv_stamp(0x124);
+	zv_crumb(0x50);
+
+	zv_status(9, monitor);
+	if (ZV_STOP == 9)
+		return;
+#ifdef ZV_TRACE
+	zv_trace_stubs(monitor, uboot);
+#endif
+	writel(0, &zv_wdog()->mode);	/* the vendor chain does not expect a running watchdog */
+	flush_dcache_all();
+	/* as boot0.h's rmr_switch: the die variant picks the RVBAR mapping */
+	if (readl((void *)(SUNXI_SRAMC_BASE + 0x24)) & 0xff) {
+		writel(monitor, (void *)(ulong)CONFIG_SUNXI_RVBAR_ALTERNATIVE);
+		writel(0, (void *)((ulong)CONFIG_SUNXI_RVBAR_ALTERNATIVE + 4));
+	} else {
+		writel(monitor, (void *)(ulong)CONFIG_SUNXI_RVBAR_ADDRESS);
+		writel(0, (void *)((ulong)CONFIG_SUNXI_RVBAR_ADDRESS + 4));
+	}
+	dcache_disable();
+	invalidate_icache_all();
+	asm volatile("dsb sy; isb; mov x0, #3; msr rmr_el3, x0; isb");
+	for (;;)
+		asm volatile("wfi");
+}
