+	setbits_le32(&priv->reg->gctrl, SUNXI_MMC_GCTRL_DMA_ENABLE | SUNXI_MMC_GCTRL_DMA_RESET);
+	writel(SUNXI_MMC_IDMAC_RESET, &priv->reg->dmac);
+	writel(0xffffffff, &priv->reg->idst);
+	writel(SUNXI_MMC_IDIE_RXIRQ, &priv->reg->idie);
+	writel((u32)((ulong)zdma_des >> 2), &priv->reg->dlba);
+	writel(SUNXI_MMC_IDMAC_FIXBURST | SUNXI_MMC_IDMAC_ENABLE, &priv->reg->dmac);
+}
+
+static void zdma_stop(struct sunxi_mmc_priv *priv, struct mmc_data *data)
+{
+	writel(0, &priv->reg->dmac);
+	writel(0, &priv->reg->idie);
+	writel(0xffffffff, &priv->reg->idst);
+	clrbits_le32(&priv->reg->gctrl, SUNXI_MMC_GCTRL_DMA_ENABLE);
+	setbits_le32(&priv->reg->gctrl, SUNXI_MMC_GCTRL_ACCESS_BY_AHB);
+	invalidate_dcache_range((ulong)data->dest, (ulong)data->dest + data->blocks * data->blocksize);
+}
+#else
+static int zdma_usable(struct mmc_data *data) { return 0; }
+static void zdma_start(struct sunxi_mmc_priv *priv, struct mmc_data *data) {}
+static void zdma_stop(struct sunxi_mmc_priv *priv, struct mmc_data *data) {}
+#endif
