$(PLATFORM):
	# $@
	cp ./workspace/$@/overclock/overclock.elf ./build/SYSTEM/$@/bin/
	cp ./workspace/$@/blank/blank.elf ./build/SYSTEM/$@/bin/
	cp ./workspace/$@/batmon/batmon.elf ./build/SYSTEM/$@/bin/
	cp ./workspace/$@/lumon/lumon.elf ./build/SYSTEM/$@/bin/
	cp ./workspace/$@/show/show.elf ./build/SYSTEM/$@/bin
	cp ./workspace/$@/other/sdl/build/.libs/libSDL-1.2.so.0.11.5 ./build/SYSTEM/$@/lib/libSDL-1.2.so.0
	# as_preload.so / audioserver.mod intentionally NOT copied. They belong to the SDL 1.2
	# latency-reduction path and the NON-Plus audio daemon; this fork routes audio through the
	# stock /customer/app/audioserver with SDL2's OSS backend and explicitly `unset LD_PRELOAD`
	# outside the game process. Nothing we ship loads either, so they were dead weight in every
	# artifact — and a preload sitting in lib/ invites someone to wire it back up.
	# installer
	cp ./workspace/$@/install/update.sh ./build/SYSTEM/$@/bin/install.sh
	mkdir -p ./build/BOOT/common/$@/
	cp ./workspace/$@/install/boot.sh ./build/BOOT/common/$@.sh
	cp ./workspace/$@/install/*.png ./build/BOOT/common/$@/
	cp ./workspace/$@/show/show.elf ./build/BOOT/common/$@/
	# extras — Clock, Input and Files (their .elf are copied by the top makefile's `system:` target).
	# Files.pak (DinguxCommander) WAS deliberately dropped here as "user-facing weight", but tg5040
	# shipped it the whole time, so the rule was applied to only one platform. Dan asked for it on the
	# Miyoo for v1.7.5 (2026-09-07), which settles the inconsistency in favour of parity: same tool set
	# on both, minus only the divergences hardware earns. The binary is already built by this
	# platform's `early:` target, so this is a copy, not a new dependency.
	# Bootlogo.pak stays OUT: a boot-logo editor is legacy weight neither platform ships.
	mkdir -p ./build/EXTRAS/Tools/$@/Files.pak
	cp ./workspace/$@/other/DinguxCommander/output/DinguxCommander ./build/EXTRAS/Tools/$@/Files.pak/
	cp -r ./workspace/$@/other/DinguxCommander/res ./build/EXTRAS/Tools/$@/Files.pak/
