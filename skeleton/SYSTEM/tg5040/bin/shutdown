#!/bin/sh

# copy to /tmp before running
case "$0" in
  /tmp/*) 
    # already running from /tmp, just continue
    ;;
  *)
    TMP_COPY="/tmp/$(basename "$0")"
    cp "$0" "$TMP_COPY"
    chmod +x "$TMP_COPY"
    exec "$TMP_COPY" "$@"
    ;;
esac

# Zero kernel (bin/zerokernel.sh): a clean power-off ends the session cleanly. Three starts in a row that end
# without one (forced 10 s hold, crash, flat battery) send the device back to the stock kernel for that kernel
# image, which is also the escape from a dark screen. A session counts as clean only when THIS boot re-armed
# (/tmp/zero-armed); a zarmed state left from an earlier session, or a boot that never re-armed, becomes the
# benign "menu" instead. Same block as workspace/tg5040/zerokernel/K01zeroclean (orderly reboots). Builtins only,
# plus one small write to the overlay (mounted sync).
_zo=; read -r _zo < /proc/sys/kernel/osrelease
if [ "$_zo" = 4.9.191-zero ] && read -r _zw _zi _zn 2>/dev/null < /etc/zero-kernel.state; then
	case "$_zw" in
	zarmed) if [ -f /tmp/zero-armed ]; then _zw=zclean; _zn=0; else _zw=menu; fi ;;  # re-armed by THIS boot, or left over
	armed|zclean|health) _zw=menu ;;  # this boot ran userspace far enough to stop in order: not a kernel failure
	esac
	echo "$_zw $_zi $_zn" > /etc/zero-kernel.state
fi

sync && umount -f -l /mnt/SDCARD

# execute poweroff
AXP=/sys/class/axp/axp_reg

# mask interrupts
for REG in 0x40 0x41 0x42 0x43 0x44; do
	echo ${REG}00 > $AXP
done

# clear irq status
for REG in 0x48 0x49 0x4A 0x4B 0x4C; do
	echo ${REG}00 > $AXP
done

# configure shutdown sources
echo 0x220A > $AXP
sleep 0.05

# trigger poweroff
echo 0x2701 > $AXP
sleep 1