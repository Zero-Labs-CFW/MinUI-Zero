#!/bin/sh
# tg5040 (TrimUI Brick) suspend-to-RAM choreography, invoked by PWR_deepSleep().
# Ported from zhaofengli/MinUI (deep-sleep branch) — community fork scene.
#
# Why the dance around `echo mem`:
#  - a wifi config present with no AP in range makes the kernel REFUSE suspend (EBUSY),
#    so we tear down wpa_supplicant / wlan0 / Bluetooth and rfkill-block first;
#  - the ALSA mixer glitches on resume unless saved/restored.
# Brick-specific bits to confirm on-device (see docs/archive/ON-DEVICE-CHECKLIST.md): service
# names, wlan0, the wpa_supplicant paths.
# Bluetooth is never used (Dan, 2026-10-05: never supported), so it is blocked before every sleep and
# NEVER brought back on wake.
set -euo pipefail
exec 0<&-

wpa_running=

asound_state_dir=/tmp/asound-suspend

before() {
	>&2 echo "Preparing for suspend..."

	>&2 echo "Saving mixer state..."
	mkdir -p "$asound_state_dir"
	alsactl --file "$asound_state_dir/asound.state.pre" store || true

	if pgrep wpa_supplicant; then
		wpa_running=1
		>&2 echo "Stopping wpa_supplicant..."
		killall -9 wpa_supplicant || true
	fi
	# udhcpc too: after() starts a fresh one, so leaving the old one alive added a client per sleep
	# (3 after two cycles, Brick Pro 2026-10-05). By pid: busybox killall skips applets.
	for p in $(pidof udhcpc 2>/dev/null || true); do kill "$p" 2>/dev/null || true; done
	ifconfig wlan0 down || true

	if pgrep hciattach; then
		>&2 echo "Stopping hciattach..."
		/etc/init.d/hciattach stop || true
	fi
	if pgrep bluetoothd; then
		>&2 echo "Stopping bluetoothd..."
		/etc/bluetooth/bluetoothd stop || true
		killall -15 bluealsa || true
	fi

	# By type, like boot.sh: this used to write rfkill0, which happens to be Bluetooth (sunxi-bt; phy0
	# is rfkill1), so the WiFi radio was never rfkill-blocked here and still is not.
	>&2 echo "Blocking Bluetooth..."
	for r in /sys/class/rfkill/rfkill*; do
		if [ "$(cat "$r/type" 2>/dev/null || true)" = "bluetooth" ]; then echo 0 > "$r/state" 2>/dev/null || true; fi
	done
}

after() {
	>&2 echo "Resumed from suspend."

	>&2 echo "Restoring mixer state..."
	alsactl --file "$asound_state_dir/asound.state.pre" restore || true

	# No rfkill writes on wake. The "Unblocking wireless" write that sat here was rfkill0 = Bluetooth, so
	# every wake powered the Bluetooth radio back up, on every card. WiFi's block is never touched.

	# A game turned WiFi off (MinUI.pak, D68): keep it off until the game exits, or waking mid-game brings
	# back the stalls. Matters after an auto-resumed boot, where the stock S96 wpa_supplicant starts late.
	if [ -f /tmp/game-wifi-off ]; then wpa_running=; fi

	if [ -n "$wpa_running" ]; then
		>&2 echo "Starting wpa_supplicant..."
		wpa_supplicant -B -D nl80211 -iwlan0 -c /etc/wifi/wpa_supplicant.conf -O /etc/wifi/sockets || true
		( udhcpc -i wlan0 & )
	fi
}

before

>&2 echo "Suspending..."
# The suspend write needs care under `set -e` (idea: NextUI #632):
#  - if it fails (EBUSY etc.), -e would kill the script HERE and `after` would never run,
#    leaving radios/audio torn down AND making PWR_deepSleep retry/power-off;
#  - the A133P can return nonzero even when the device DID suspend — if we were gone
#    >=5s, treat the suspend as a success so the C side doesn't spuriously retry.
T0=$(date +%s)
set +e
echo mem >/sys/power/state
rc=$?
set -e
T1=$(date +%s)
if [ $rc -ne 0 ] && [ $((T1-T0)) -ge 5 ]; then rc=0; fi

# Resume services in the background to reduce UI latency — ALWAYS, even on a failed suspend
( after & )

exit $rc
